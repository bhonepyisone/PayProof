PORT=8765

# LLM Parser (LiteLLM proxy for multi-format receipt extraction)
LLM_API_KEY=your_vibecode_tours_proxy_key
LLM_BASE_URL=https://proxy.vibecode.tours
LLM_MODEL=gpt-4o-mini

# CORS origins for production (comma-separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,https://payproof.vercel.app

# GoatCounter analytics (free, privacy-first)
VITE_GOATCOUNTER_CODE=your_goatcounter_code

# Backend API URL for frontend (set in Vercel project settings)
VITE_API_URL=https://payproof-api-xxxxx-uc.a.run.app